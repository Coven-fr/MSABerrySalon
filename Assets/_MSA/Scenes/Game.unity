  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ce jeu vous permet de d\xE9couvrir les m\xE9tiers du service Sant\xE9-S\xE9curit\xE9
    au Travail et les actions qu\u2019ils peuvent mettre en \u0153uvre pour vous
    accompagner en cas de difficult\xE9.\n\nVous incarnerez un adh\xE9rent de la
    MSA, selon le profil de votre choix : salari\xE9, employeur ou exploitant travaillant
    seul.\n\nVotre mission : identifier les actions adapt\xE9es \xE0 la situation
    de votre profil \nen s\xE9lectionnant les bonnes propositions.\nAttention : certaines
    propositions sont des pi\xE8ges. Elles ne correspondent pas au m\xE9tier concern\xE9
    ou ne r\xE9pondent pas correctement \xE0 la demande.\n\nChaque bonne r\xE9ponse
    vous rapporte des points. Soyez attentifs !"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c6c50a00a7324aa439a64b0ce52b737c, type: 2}
