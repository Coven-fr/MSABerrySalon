  m_Name: Salarie
  m_EditorClassIdentifier: Assembly-CSharp::RoleData
  displayName: "SALARI\xC9.E"
  role: 0
  intro: {fileID: 11400000, guid: f6d9a9949b2b3c64295b21a23628d25b, type: 2}
  elements:
  - id: 1
    quizData: {fileID: 11400000, guid: 978119c75f8cf344e8859732df44ce0a, type: 2}
    resultsData:
      title: "Rendez-vous avec le p\xF4le sant\xE9 au travail"
      content: "Le dossier de Nadia est d\xE9sormais enregistr\xE9 et ses droits
        sont ouverts. Pour comprendre l'origine de ses douleurs, l'agent d'accueil
        l'oriente vers le <b>p\xF4le sant\xE9 au travail</b>."
      Score: 0
  - id: 3
    quizData: {fileID: 11400000, guid: 7181dc9aae904cc478fa04cc81b3e3cf, type: 2}
    resultsData:
      title: "Rendez-vous avec un m\xE9decin"
      content: "L\u2019infirmier du p\xF4le sant\xE9 au travail m\u2019a re\xE7u
        pour faire le point sur ma situation, mes ressentis et mes difficult\xE9s
        au travail.\r\n\r\nIl m\u2019a ensuite orient\xE9 vers le m\xE9decin du travail
        pour \xE9valuer les impacts sur ma sant\xE9 et envisager, si besoin, des
        am\xE9nagements."
      Score: 0
  - id: 4
    quizData: {fileID: 11400000, guid: ceb6f15263256f446b7f457a76a1b088, type: 2}
    resultsData:
      title: 
      content: 
      Score: 0
  endText: "Le service Sant\xE9 S\xE9curit\xE9 au Travail accompagne durablement
    les travailleurs pour garantir leur s\xE9curit\xE9, pr\xE9server leur \xE9tat
    sant\xE9 et am\xE9liorer leurs conditions de travail.\r\n\r\nEn faisant appel
    au service SST comme\_Nadia, vous b\xE9n\xE9ficierez d\u2019une \xE9coute attentive,
    d\u2019un accompagnement personnalis\xE9 et d\u2019une orientation vers les interlocuteurs
    les plus adapt\xE9s \xE0 vos besoins. Nous vous aidons \xE0 agir \xE0 la fois
    sur la pr\xE9vention des risques professionnels et sur le suivi de la sant\xE9
    au travail."
