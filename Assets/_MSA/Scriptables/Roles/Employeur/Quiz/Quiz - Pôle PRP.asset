  m_Script: {fileID: 11500000, guid: 468e71a82275fdf41b90fbeabf52565e, type: 3}
  m_Name: "Quiz - P\xF4le PRP"
  m_EditorClassIdentifier: Assembly-CSharp::QuizData
  question: "Le conseiller PRP peut m\u2019accompagner en : "
  answers:
  - id: 1
    text: "R\xE9alisant une visite de diagnostic des risques pour comprendre l'accident"
    isCorrect: 1
  - id: 2
    text: "M\u2019aidant \xE0 mettre \xE0 jour mon Document Unique d'\xC9valuation
      des Risques Professionnels (DUERP)"
    isCorrect: 1
  - id: 3
    text: "Suivant mon \xE9tat de sant\xE9"
    isCorrect: 0
  - id: 4
    text: "Accompagnant la mise en \u0153uvre d'actions de sensibilisation et de
      formation pour l'ensemble des salari\xE9s"
    isCorrect: 1
  explanation: "La d\xE9claration de l'accident est enregistr\xE9e. L'administration
    missionne imm\xE9diatement un conseiller PRP pour investiguer directement sur
    mon entreprise."
