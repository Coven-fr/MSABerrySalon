  question: "L\u2019assistant.e administratif.ve peut m\u2019accompagner en : "
  answers:
  - id: 1
    text: "M\u2019orientant vers le p\xF4le pr\xE9vention."
    isCorrect: 1
  - id: 2
    text: "Recueillant les premi\xE8res informations sur mon activit\xE9."
